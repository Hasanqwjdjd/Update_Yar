<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- deep-link بازگشت به اپ (updatayar://payment) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="updatayar" android:host="payment" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- برای نصب بسته‌های به‌روزرسانی (در آنبوردینگ اپ توضیح داده شده است) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- لازمه‌ی اصلی اپ: خواندن لیست برنامه‌های نصب‌شده روی گوشی (اندروید ۱۱+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- اعلان‌های آپدیت (اندروید ۱۳+ با درخواست runtime از خود کاربر گرفته می‌شود) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- تشخیص فروشگاه‌ها برای باز کردن صفحه‌ی آپدیت -->
    <queries>
        <package android:name="com.farsitel.bazaar" />
        <package android:name="ir.mservices.market" />
        <package android:name="com.android.vending" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="bazaar" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="myket" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <!--
        پکیج‌های کاتالوگ: حتی اگر گوشی (مثلاً شیائومی/MIUI) دسترسی لیست کامل را محدود کند،
        این برنامه‌ها با getPackageInfo قابل شناسایی‌اند و اسکن حداقلی ممکن می‌شود
    -->
    <queries>
        <package android:name="com.digikala" />
        <package android:name="com.instagram.android" />
        <package android:name="org.telegram.messenger" />
        <package android:name="app.snapp.passenger" />
        <package android:name="com.snappfood" />
        <package android:name="app.bale.messenger" />
        <package android:name="com.aparat" />
        <package android:name="com.soroush.plus" />
        <package android:name="com.torob.mobile" />
        <package android:name="com.mellat.bbank" />
        <package android:name="com.filimo" />
        <package android:name="com.whatsapp" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.youtube" />
        <package android:name="org.schabi.newpipe" />
        <package android:name="dev.patrickgold.florisboard" />
    </queries>
</manifest>
